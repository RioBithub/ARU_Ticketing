NODE_ENV=production
PORT=3000
APP_NAME=ARU IT Ticketing
APP_BASE_URL=https://ticketing.example.co.id
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true
SESSION_SECRET=replace-with-a-long-random-secret
INTERNAL_EMAIL_DOMAIN=aruraharja.co.id

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aru_ticketing
DB_USER=replace_mysql_username
DB_PASSWORD=replace_mysql_password
DB_CONNECTION_LIMIT=5

# Root administrator seed (only used if no root admin exists in MySQL)
ROOT_ADMIN_USERNAME=admin
ROOT_ADMIN_EMAIL=root-admin@example.com
ROOT_ADMIN_PASSWORD=replace-me
ROOT_ADMIN_NAME=Root Admin
ROOT_ADMIN_DEPARTMENT=IT Web Development & Operations

# SMTP - keep the values from your previous .env, then fix credentials if needed
SMTP_HOST=mail.aruraharja.co.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=deva-auto@aruraharja.co.id
SMTP_PASS=replace-me
MAIL_FROM_NAME=ARU IT Ticketing
MAIL_FROM_ADDRESS=deva-auto@aruraharja.co.id

OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
SESSION_HOURS=12
MAX_UPLOAD_FILES=10
MAX_UPLOAD_MB=5
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_WEBP_QUALITY=68
